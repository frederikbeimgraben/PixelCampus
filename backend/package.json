{
  "name": "pixelcampus-api",
  "version": "1.0.0",
  "description": "Read-only HTTP API that fronts PLAN and ServerTap for the PixelCampus web front end.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint .",
    "prebuild": "node ../scripts/sync-contract.mjs backend",
    "prelint": "node ../scripts/sync-contract.mjs backend",
    "pretest": "node ../scripts/sync-contract.mjs backend",
    "pretypecheck": "node ../scripts/sync-contract.mjs backend",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/websocket": "^11.3.0",
    "@orpc/openapi": "^1.14.15",
    "@orpc/server": "^1.14.15",
    "fastify": "^5.11.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-jsdoc": "^64.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "tsx": "^4.23.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
