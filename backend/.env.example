# PixelCampus API configuration.
# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# --- HTTP -------------------------------------------------------------------
PORT=8080
LOG_LEVEL=info

# nginx proxies this service at /api/v1 on the site's own host, so it does not
# need an address of its own. Containers need 0.0.0.0 to be reachable at all.
HOST=127.0.0.1

# Comma-separated origins allowed to call this API. Behind nginx, and behind the
# front end's dev-server proxy, every request is same-origin and no browser
# sends a preflight; this only matters for clients that reach the service
# directly.
CORS_ORIGINS=https://pixelcampus.space

# Requests per minute per client address.
RATE_LIMIT_PER_MINUTE=120

# --- Upstreams --------------------------------------------------------------
# The game server, read the way a game client reads it, with a server list
# ping. This needs no plugin, and it ties the site to no version of the game.
# Leave MC_HOST empty to report the server as offline.
#
# A ping gives the MOTD, the version and the player counts. The list of names
# it carries is a sample: a server sends about twelve of them, and an operator
# can turn the sample off.
MC_HOST=
MC_PORT=25565
# Name shown for the server. A ping carries no name of its own.
SERVER_NAME=PixelCampus

# PLAN (Player Analytics) holds the history: playtime, sessions and the rest.
# It also reports whether one named player is connected.
PLAN_URL=
PLAN_USER=
PLAN_PASSWORD=

# --- Skin rendering ---------------------------------------------------------
# Renders are proxied so the browser never contacts a third party.
SKIN_RENDER_URL=https://mc-heads.net

# --- Caching and timeouts ---------------------------------------------------
# The game server shares hardware with players; caching keeps page views from
# becoming plugin queries.
CACHE_TTL_SECONDS=60
SKIN_CACHE_TTL_SECONDS=86400
UPSTREAM_TIMEOUT_MS=5000

# --- Live updates -----------------------------------------------------------
# The socket at /api/v1/live re-reads what its listeners watch on this interval,
# and only while at least one is connected. One query serves every listener
# watching the same thing. 0 turns the socket off.
LIVE_POLL_SECONDS=5
LIVE_MAX_CLIENTS=200
# Clients that miss two pings are dropped, so a vanished browser frees its slot.
LIVE_PING_SECONDS=30
