{
  "name": "pixel-campus",
  "version": "1.0.0",
  "description": "Web front end of the PixelCampus Minecraft server.",
  "license": "MIT",
  "private": true,
  "packageManager": "npm@11.16.0",
  "scripts": {
    "build": "ng build",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\"",
    "generate:env": "node scripts/generate-env.mjs",
    "lint": "ng lint",
    "ng": "ng",
    "prebuild": "npm run sync:contract && npm run generate:env",
    "prestart": "npm run sync:contract && npm run generate:env",
    "pretest": "npm run sync:contract && npm run generate:env",
    "prewatch": "npm run sync:contract && npm run generate:env",
    "start": "ng serve",
    "start:ssr": "node dist/PixelCampus/server/server.mjs",
    "sync:contract": "node ../scripts/sync-contract.mjs frontend",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "update:assets": "node scripts/update-minecraft-assets.mjs",
    "watch": "ng build --watch --configuration development"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.3",
    "@jsverse/transloco": "^8.4.0",
    "@orpc/client": "^1.14.15",
    "@orpc/contract": "^1.14.15",
    "@orpc/openapi-client": "^1.14.15",
    "express": "^5.1.0",
    "rxjs": "~7.8.2",
    "skinview3d": "^3.4.2",
    "tslib": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.1",
    "@types/express": "^5.0.1",
    "@types/node": "^26.1.2",
    "adm-zip": "^0.6.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
