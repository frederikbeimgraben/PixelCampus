# PixelCampus front-end configuration.
# Copy to .env and adjust. .env is gitignored.
#
# Angular compiles ahead of time, so these are read at BUILD time, not run time:
# scripts/generate-env.mjs turns them into a typed module before ng runs.
# Rebuild after changing anything here. Nothing secret belongs in this file --
# every value ends up in the JavaScript bundle the browser downloads.

# Backends. Empty means "this origin", which is the deployed setup: nginx serves
# the site and proxies /api/v1 to pixelcampus-api and /api/minecraft to the old
# API, so nothing is cross-origin. Set a full URL only to point at an API on
# another host, and widen connect-src and img-src in src/index.html and
# deploy/nginx-site.conf to match.
PC_LEGACY_API_URL=
PC_STATS_API_URL=

# --- Read when a process starts, not compiled in -----------------------------
# Where `ng serve` forwards those two paths during development; it stands in for
# nginx. Read by proxy.conf.mjs at dev-server start.
PC_DEV_API_TARGET=http://127.0.0.1:8080
PC_DEV_LEGACY_API_TARGET=https://api.pixelcampus.space

# Where the rendering server reaches the APIs. It has no origin of its own, so
# it cannot use the relative paths above, and it may as well skip nginx.
# The NixOS module sets these; they are here for running the server by hand.
PC_SSR_API_URL=http://127.0.0.1:8080
PC_SSR_LEGACY_API_URL=https://api.pixelcampus.space

# Shown on the "How to Connect" card.
PC_SERVER_HOST=pixelcampus.space
PC_BEDROCK_PORT=19132

# Landing page entries.
PC_MAP_URL=https://map.pixelcampus.space/
PC_WIKI_URL=https://wiki.pixelcampus.space/
PC_DISCORD_URL=https://discord.gg/HQGBwFA3vD

# Footer links.
PC_CONTACT_URL=mailto:support@pixelcampus.space
PC_PRIVACY_URL=https://wiki.pixelcampus.space/de/impressum-und-datenschutz
