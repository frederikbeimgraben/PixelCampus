{
  "name": "pixel-campus",
  "version": "1.0.0",
  "description": "Web front end of the PixelCampus Minecraft server.",
  "license": "MIT",
  "private": true,
  "packageManager": "npm@11.16.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\""
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.0.8"
  }
}
