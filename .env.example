# PixelCampus front-end configuration.
# Copy to .env and adjust. .env is gitignored.
#
# Angular compiles ahead of time, so these are read at BUILD time, not run time:
# scripts/generate-env.mjs turns them into a typed module before ng runs.
# Rebuild after changing anything here. Nothing secret belongs in this file --
# every value ends up in the JavaScript bundle the browser downloads.

# Backends. Both currently point at the same host; the stats API is the new
# pixelcampus-api service. Keep these in sync with the connect-src and img-src
# lists in src/index.html and deploy/nginx-security-headers.conf.
PC_LEGACY_API_URL=https://api.pixelcampus.space
PC_STATS_API_URL=https://api.pixelcampus.space

# Shown on the "How to Connect" card.
PC_SERVER_HOST=pixelcampus.space
PC_BEDROCK_PORT=19132

# Landing page entries.
PC_MAP_URL=https://map.pixelcampus.space/
PC_WIKI_URL=https://wiki.pixelcampus.space/
PC_DISCORD_URL=https://discord.gg/HQGBwFA3vD

# Footer links.
PC_CONTACT_URL=mailto:support@pixelcampus.space
PC_PRIVACY_URL=https://wiki.pixelcampus.space/de/impressum-und-datenschutz
